{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "assemble": {
      "dependsOn": ["@questspec/cli#build", "@questspec/preview#build"],
      "outputs": ["dist/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@questspec/core#build": {
      "outputs": []
    },
    "@questspec/ui#build": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
