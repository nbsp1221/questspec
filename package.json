{
  "name": "questspec",
  "version": "0.1.0",
  "description": "Questbooks as code for Minecraft, with declarative authoring, validation, and version-aware compilation",
  "keywords": [
    "cli",
    "compiler",
    "declarative",
    "ftb-quests",
    "minecraft",
    "questbook",
    "static-analysis",
    "typescript"
  ],
  "homepage": "https://github.com/nbsp1221/questspec#readme",
  "bugs": {
    "url": "https://github.com/nbsp1221/questspec/issues"
  },
  "license": "MIT",
  "author": "nbsp1221",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbsp1221/questspec.git"
  },
  "bin": {
    "questspec": "dist/index.mjs"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:node && pnpm build:browser",
    "build:browser": "node scripts/build-preview.ts",
    "build:node": "tsdown",
    "benchmark": "node scripts/benchmark-snbt.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm build:browser && tsdown --watch",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix .",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "questspec": "node src/index.ts",
    "schema:generate": "node scripts/write-schema.ts && oxfmt schema/questspec-1.json",
    "test": "pnpm build:browser && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json"
  },
  "dependencies": {
    "@statelyai/graph": "2.3.0",
    "@xyflow/react": "12.11.5",
    "ajv": "^8.20.0",
    "cac": "^7.0.0",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-aria-components": "1.20.0",
    "react-dom": "19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@retn0/eslint-config": "^2.1.0",
    "@retn0/eslint-config-oxlint": "^0.1.2",
    "@retn0/oxfmt-config": "^0.2.0",
    "@retn0/oxlint-config": "^2.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "esbuild": "0.28.2",
    "eslint": "^10.8.0",
    "jsdom": "30.0.1",
    "oxfmt": "^0.59.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.25.0",
    "postcss": "^8.5.26",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
