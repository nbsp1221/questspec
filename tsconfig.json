{
  "compilerOptions": {
    "target": "es2025",
    "module": "nodenext",
    "lib": ["es2025", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"],
    "jsx": "react-jsx",
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["scripts", "src", "tests", "*.config.ts"]
}
