{
  "compilerOptions": {
    "target": "es2025",
    "module": "nodenext",
    "lib": ["es2025"],
    "types": ["node"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "*.config.ts"]
}
